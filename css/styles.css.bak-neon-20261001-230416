/* ===================================
   VARIABLES
=================================== */

:root {
    --bg: #060810;
    --bg-secondary: #0b0f19;
    --card: #101725;
    --card-light: #151e2f;

    --text: #f8fafc;
    --text-secondary: #94a3b8;

    --blue: #38bdf8;
    --blue-dark: #0284c7;
    --cyan: #22d3ee;

    --border: rgba(255, 255, 255, 0.08);

    --gradient:
        linear-gradient(
            135deg,
            #38bdf8,
            #22d3ee
        );

    --shadow:
        0 25px 60px
        rgba(0, 0, 0, 0.35);
}


/* ===================================
   RESET
=================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Inter", sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    overflow-x: hidden;
}

a {
    text-decoration: none;
    color: inherit;
}

button,
input {
    font: inherit;
}

button {
    cursor: pointer;
}

.container {
    width: min(1180px, 90%);
    margin: auto;
}

.section {
    padding: 110px 0;
}


/* ===================================
   HEADER
=================================== */

.header {
    position: fixed;
    width: 100%;
    top: 0;
    left: 0;
    z-index: 1000;

    border-bottom: 1px solid transparent;

    transition: 0.3s;
}

.header.scrolled {
    background: rgba(6, 8, 16, 0.88);
    backdrop-filter: blur(18px);
    border-color: var(--border);
}

.navbar {
    height: 82px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
}

.logo-icon {
    width: 42px;
    height: 42px;

    background: var(--gradient);
    color: #031018;

    display: grid;
    place-items: center;

    border-radius: 10px;

    font-family: "Space Grotesk", sans-serif;
    font-weight: 800;
    font-size: 23px;
}

.logo div {
    line-height: 1;
}

.logo strong,
.logo span {
    display: block;
}

.logo strong {
    font-family: "Space Grotesk", sans-serif;
    letter-spacing: 1px;
    font-size: 14px;
}

.logo div span {
    color: var(--blue);
    font-size: 12px;
    letter-spacing: 5px;
    margin-top: 5px;
}

.nav-links {
    display: flex;
    gap: 35px;
    list-style: none;
}

.nav-links a {
    color: var(--text-secondary);
    font-size: 14px;
    transition: 0.25s;
}

.nav-links a:hover {
    color: var(--blue);
}

.menu-toggle {
    display: none;
    border: none;
    background: none;
    color: white;
    font-size: 25px;
}


/* ===================================
   HERO
=================================== */

.hero {
    min-height: 100vh;
    position: relative;

    display: flex;
    align-items: center;

    padding-top: 85px;

    overflow: hidden;

    background:
        radial-gradient(
            circle at 80% 35%,
            rgba(56, 189, 248, 0.10),
            transparent 30%
        ),
        var(--bg);
}

.hero::before {
    content: "";

    position: absolute;
    inset: 0;

    background-image:
        linear-gradient(
            rgba(255,255,255,.018) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255,255,255,.018) 1px,
            transparent 1px
        );

    background-size: 55px 55px;

    mask-image:
        linear-gradient(
            to bottom,
            black,
            transparent
        );
}

.hero-content {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    align-items: center;
    gap: 70px;

    position: relative;
    z-index: 2;
}

.eyebrow,
.section-label {
    color: var(--blue);

    font-size: 12px;
    font-weight: 800;

    letter-spacing: 3px;
}

.hero h1 {
    font-family: "Space Grotesk", sans-serif;

    font-size: clamp(
        50px,
        6vw,
        82px
    );

    line-height: 0.98;

    letter-spacing: -4px;

    margin: 20px 0 25px;
}

.hero h1 span {
    display: block;

    background: var(--gradient);

    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero-description {
    color: var(--text-secondary);

    max-width: 620px;

    font-size: 17px;
    line-height: 1.8;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;

    margin-top: 35px;
}

.btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;

    padding: 15px 24px;

    border-radius: 10px;

    font-size: 14px;
    font-weight: 700;

    transition: .3s;
}

.btn-primary {
    background: var(--gradient);
    color: #041018;
}

.btn-primary:hover {
    transform: translateY(-3px);

    box-shadow:
        0 15px 35px
        rgba(56,189,248,.18);
}

.btn-secondary {
    border: 1px solid var(--border);

    background:
        rgba(255,255,255,.025);
}

.btn-secondary:hover {
    border-color: var(--blue);
}

.hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;

    margin-top: 30px;

    color: var(--text-secondary);
    font-size: 12px;
}

.hero-tags span::first-letter {
    color: var(--blue);
}


/* ===================================
   PC ILUSTRADA
=================================== */

.hero-visual {
    display: flex;
    justify-content: center;
}

.pc-card {
    position: relative;

    width: 430px;
    height: 500px;
}

.pc-case {
    width: 330px;
    height: 430px;

    position: absolute;

    left: 50%;
    top: 50%;

    transform:
        translate(-50%, -50%);

    background:
        linear-gradient(
            145deg,
            #121b2a,
            #080b11
        );

    border:
        1px solid
        rgba(255,255,255,.12);

    border-radius: 24px;

    padding: 20px;

    box-shadow: var(--shadow);
}

.case-top {
    height: 35px;

    font-family:
        "Space Grotesk",
        sans-serif;

    font-size: 10px;
    font-weight: 700;

    letter-spacing: 2px;

    color: var(--text-secondary);
}

.case-top span {
    color: var(--blue);
}

.case-window {
    height: calc(100% - 35px);

    border:
        1px solid
        rgba(56,189,248,.20);

    border-radius: 15px;

    background:
        rgba(56,189,248,.025);

    position: relative;

    overflow: hidden;
}

.motherboard {
    position: absolute;

    width: 230px;
    height: 275px;

    left: 28px;
    top: 42px;

    background:
        linear-gradient(
            145deg,
            #172337,
            #0f1725
        );

    border:
        1px solid
        rgba(56,189,248,.18);

    border-radius: 10px;
}

.component-label {
    position: absolute;

    top: 9px;
    left: 10px;

    font-size: 7px;

    color:
        rgba(255,255,255,.3);

    letter-spacing: 2px;
}

.cpu {
    position: absolute;

    width: 78px;
    height: 78px;

    top: 52px;
    left: 42px;

    display: grid;
    place-items: center;

    border-radius: 8px;

    border:
        1px solid
        rgba(56,189,248,.55);

    background:
        radial-gradient(
            circle,
            rgba(56,189,248,.15),
            #0c1320
        );

    color: var(--blue);

    font-weight: 800;
    font-size: 11px;
}

.ram {
    position: absolute;

    width: 12px;
    height: 100px;

    background:
        linear-gradient(
            to bottom,
            #38bdf8,
            #155e75
        );

    border-radius: 2px;

    top: 40px;
}

.ram-one {
    right: 55px;
}

.ram-two {
    right: 35px;
}

.gpu {
    position: absolute;

    height: 48px;
    width: 180px;

    left: 25px;
    bottom: 55px;

    border-radius: 6px;

    background:
        linear-gradient(
            90deg,
            #182337,
            #25364f
        );

    border:
        1px solid
        rgba(255,255,255,.10);

    display: flex;
    align-items: center;

    padding-left: 20px;

    color: var(--blue);

    font-size: 9px;
    font-weight: 800;
}

.fan {
    position: absolute;

    width: 42px;
    height: 42px;

    border:
        2px solid
        rgba(56,189,248,.35);

    border-radius: 50%;

    display: grid;
    place-items: center;
}

.fan div {
    width: 8px;
    height: 8px;

    background: var(--blue);

    border-radius: 50%;
}

.fan-one {
    bottom: 5px;
    left: 25px;
}

.fan-two {
    bottom: 5px;
    left: 75px;
}

.pc-glow {
    position: absolute;

    width: 300px;
    height: 300px;

    background:
        rgba(56,189,248,.18);

    filter: blur(100px);

    left: 50%;
    top: 50%;

    transform:
        translate(-50%, -50%);
}

.floating-chip {
    position: absolute;

    padding: 10px 15px;

    border:
        1px solid
        rgba(255,255,255,.10);

    background:
        rgba(12,18,29,.87);

    backdrop-filter: blur(12px);

    border-radius: 9px;

    font-size: 10px;

    color: var(--text-secondary);

    box-shadow:
        0 15px 35px
        rgba(0,0,0,.3);
}

.floating-chip span {
    display: block;

    color: var(--blue);

    font-size: 11px;
    font-weight: 800;

    margin-bottom: 2px;
}

.chip-cpu {
    left: -5px;
    top: 105px;
}

.chip-gpu {
    right: -10px;
    bottom: 120px;
}

.chip-ram {
    right: 0;
    top: 70px;
}


/* ===================================
   ESTADÍSTICAS
=================================== */

.stats {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);

    background: var(--bg-secondary);
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
}

.stat {
    padding: 35px;

    text-align: center;

    border-right:
        1px solid var(--border);
}

.stat:last-child {
    border-right: none;
}

.stat strong {
    display: block;

    font-family:
        "Space Grotesk",
        sans-serif;

    color: var(--blue);

    font-size: 34px;
}

.stat span {
    color: var(--text-secondary);

    font-size: 12px;

    text-transform: uppercase;
    letter-spacing: 1px;
}


/* ===================================
   ENCABEZADOS DE SECCIÓN
=================================== */

.section-heading {
    display: flex;
    gap: 30px;

    margin-bottom: 55px;
}

.section-number {
    color:
        rgba(56,189,248,.35);

    font-family:
        "Space Grotesk",
        sans-serif;

    font-size: 13px;

    padding-top: 6px;
}

.section-heading h2,
.about-section h2 {
    font-family:
        "Space Grotesk",
        sans-serif;

    font-size:
        clamp(
            34px,
            4vw,
            55px
        );

    line-height: 1.08;

    letter-spacing: -2px;

    margin: 10px 0 15px;
}

.section-heading h2 span,
.about-section h2 span {
    color: var(--blue);
}

.section-heading p {
    color: var(--text-secondary);

    max-width: 620px;
}


/* ===================================
   COMPONENTES
=================================== */

.components-section {
    background:
        linear-gradient(
            180deg,
            var(--bg),
            var(--bg-secondary)
        );
}

.search-area {
    display: flex;
    justify-content: space-between;
    gap: 25px;

    margin-bottom: 45px;
}

.search-box {
    flex: 1;
    max-width: 530px;

    display: flex;
    align-items: center;

    background: var(--card);

    border:
        1px solid var(--border);

    border-radius: 12px;

    padding: 0 18px;
}

.search-icon {
    color: var(--blue);

    font-size: 24px;

    margin-right: 10px;
}

.search-box input {
    width: 100%;

    padding: 16px 0;

    border: none;
    outline: none;

    color: white;

    background: transparent;
}

.search-box input::placeholder {
    color: #64748b;
}

.filters {
    display: flex;
    gap: 8px;
}

.filter-btn {
    border:
        1px solid var(--border);

    border-radius: 9px;

    padding: 11px 18px;

    background:
        rgba(255,255,255,.02);

    color: var(--text-secondary);

    transition: .25s;
}

.filter-btn:hover,
.filter-btn.active {
    color: #061018;

    border-color: var(--blue);

    background: var(--blue);
}

.components-grid {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 18px;
}

.component-card {
    position: relative;

    min-height: 275px;

    background:
        linear-gradient(
            145deg,
            var(--card),
            #0c111c
        );

    border:
        1px solid var(--border);

    border-radius: 16px;

    padding: 23px;

    overflow: hidden;

    cursor: pointer;

    transition: .35s;
}

.component-card::before {
    content: "";

    width: 130px;
    height: 130px;

    position: absolute;

    right: -50px;
    top: -50px;

    background:
        rgba(56,189,248,.08);

    filter: blur(25px);

    border-radius: 50%;
}

.component-card:hover {
    transform: translateY(-8px);

    border-color:
        rgba(56,189,248,.4);

    box-shadow:
        0 20px 45px
        rgba(0,0,0,.25);
}

.card-type {
    display: inline-block;

    color: var(--blue);

    background:
        rgba(56,189,248,.08);

    border:
        1px solid
        rgba(56,189,248,.15);

    border-radius: 30px;

    padding: 5px 9px;

    font-size: 9px;
    font-weight: 800;

    letter-spacing: 1px;

    text-transform: uppercase;
}

.card-icon {
    font-size: 42px;

    margin:
        25px 0 18px;
}

.component-card h3 {
    font-family:
        "Space Grotesk",
        sans-serif;

    font-size: 19px;

    margin-bottom: 5px;
}

.component-card p {
    color: var(--text-secondary);

    font-size: 12px;
}

.card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;

    margin-top: 22px;

    border-top:
        1px solid var(--border);

    padding-top: 15px;

    color: var(--text-secondary);

    font-size: 11px;
}

.card-footer span:last-child {
    color: var(--blue);

    font-size: 16px;
}

.hidden {
    display: none !important;
}

.empty-state {
    text-align: center;

    padding: 70px 20px;

    color: var(--text-secondary);
}

.empty-state span {
    display: block;

    color: var(--blue);

    font-size: 50px;
}


/* ===================================
   CÓMO FUNCIONA
=================================== */

.how-section {
    background: var(--bg-secondary);
}

.computer-diagram {
    position: relative;

    width: 750px;
    max-width: 100%;

    height: 520px;

    margin: 20px auto 80px;
}

.diagram-center {
    position: absolute;

    width: 200px;
    height: 200px;

    top: 50%;
    left: 50%;

    transform:
        translate(-50%, -50%);

    border:
        1px solid
        rgba(56,189,248,.35);

    background:
        radial-gradient(
            circle,
            rgba(56,189,248,.15),
            var(--card)
        );

    border-radius: 50%;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    box-shadow:
        0 0 70px
        rgba(56,189,248,.08);
}

.diagram-center span,
.diagram-center small {
    color: var(--text-secondary);

    font-size: 9px;

    letter-spacing: 2px;
}

.diagram-center strong {
    color: var(--blue);

    font-family:
        "Space Grotesk",
        sans-serif;

    margin: 4px 0;
}

.diagram-item {
    position: absolute;

    display: flex;
    align-items: center;

    gap: 13px;

    width: 210px;

    padding: 14px;

    border:
        1px solid var(--border);

    border-radius: 12px;

    background: var(--card);
}

.diagram-icon {
    min-width: 47px;
    height: 47px;

    display: grid;
    place-items: center;

    border-radius: 9px;

    background:
        rgba(56,189,248,.08);

    color: var(--blue);

    font-size: 11px;
    font-weight: 800;
}

.diagram-item strong {
    display: block;

    font-size: 12px;
}

.diagram-item span {
    color: var(--text-secondary);

    font-size: 10px;
}

.item-cpu {
    top: 20px;
    left: 50%;

    transform: translateX(-50%);
}

.item-ram {
    left: 15px;
    top: 50%;

    transform: translateY(-50%);
}

.item-storage {
    right: 15px;
    top: 50%;

    transform: translateY(-50%);
}

.item-gpu {
    bottom: 20px;
    left: 50%;

    transform: translateX(-50%);
}

.hardware-types {
    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: 25px;
}

.hardware-type-card {
    position: relative;

    padding: 40px;

    border:
        1px solid var(--border);

    background: var(--card);

    border-radius: 16px;
}

.type-number {
    position: absolute;

    right: 30px;
    top: 22px;

    color:
        rgba(255,255,255,.08);

    font-family:
        "Space Grotesk",
        sans-serif;

    font-size: 40px;
}

.type-icon {
    color: var(--blue);

    font-size: 30px;

    margin-bottom: 25px;
}

.hardware-type-card h3 {
    font-family:
        "Space Grotesk",
        sans-serif;

    margin-bottom: 12px;

    font-size: 22px;
}

.hardware-type-card p {
    color: var(--text-secondary);

    font-size: 14px;

    line-height: 1.8;
}

.type-examples {
    margin-top: 25px;

    padding-top: 20px;

    border-top:
        1px solid var(--border);

    color: var(--blue);

    font-size: 11px;
}


/* ===================================
   ABOUT
=================================== */

.about-section {
    background: #05070c;
}

.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: 100px;
    align-items: center;
}

.about-content p {
    color: var(--text-secondary);

    margin-bottom: 20px;

    font-size: 15px;

    line-height: 1.9;
}


/* ===================================
   MODAL
=================================== */

.modal-overlay {
    display: none;

    position: fixed;

    inset: 0;

    background:
        rgba(0,0,0,.82);

    backdrop-filter: blur(10px);

    z-index: 2000;

    padding: 30px;

    overflow-y: auto;
}

.modal-overlay.active {
    display: flex;

    align-items: flex-start;
    justify-content: center;
}

.modal {
    position: relative;

    width: min(1050px, 100%);

    margin: 30px auto;

    padding: 45px;

    background: var(--bg-secondary);

    border:
        1px solid var(--border);

    border-radius: 20px;

    box-shadow: var(--shadow);
}

.modal-close {
    position: absolute;

    right: 20px;
    top: 15px;

    width: 38px;
    height: 38px;

    border-radius: 50%;

    border:
        1px solid var(--border);

    color: white;

    background: var(--card);

    font-size: 25px;

    z-index: 5;
}


/* ===================================
   FOOTER
=================================== */

.footer {
    border-top:
        1px solid var(--border);

    padding: 35px 0;

    background: #040609;
}

.footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.footer p {
    color: var(--text-secondary);

    font-size: 12px;
}

.footer > div > a {
    color: var(--blue);

    font-size: 12px;
}


/* ===================================
   RESPONSIVE
=================================== */

@media (max-width: 1000px) {

    .hero-content {
        grid-template-columns: 1fr;
        padding:
            80px 0 50px;
    }

    .hero-text {
        text-align: center;
    }

    .hero-description {
        margin: auto;
    }

    .hero-buttons,
    .hero-tags {
        justify-content: center;
    }

    .components-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .about-grid {
        grid-template-columns: 1fr;
        gap: 25px;
    }
}


@media (max-width: 750px) {

    .menu-toggle {
        display: block;
    }

    .nav-links {
        display: none;

        position: absolute;

        top: 82px;
        left: 5%;

        width: 90%;

        padding: 25px;

        flex-direction: column;

        background: #0b101a;

        border:
            1px solid var(--border);

        border-radius: 15px;
    }

    .nav-links.active {
        display: flex;
    }

    .hero h1 {
        letter-spacing: -2px;
    }

    .hero-visual {
        transform: scale(.86);

        margin:
            -35px 0;
    }

    .stats-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .stat:nth-child(2) {
        border-right: none;
    }

    .stat:nth-child(-n+2) {
        border-bottom:
            1px solid var(--border);
    }

    .search-area {
        flex-direction: column;
    }

    .search-box {
        max-width: none;
    }

    .components-grid {
        grid-template-columns: 1fr;
    }

    .filters {
        overflow-x: auto;
    }

    .hardware-types {
        grid-template-columns: 1fr;
    }

    .computer-diagram {
        height: auto;

        display: grid;

        gap: 15px;
    }

    .diagram-center,
    .diagram-item {
        position: static;

        width: 100%;

        transform: none;
    }

    .diagram-center {
        height: 160px;

        border-radius: 15px;
    }

    .section-heading {
        gap: 12px;
    }

    .modal {
        padding: 35px 20px;
    }

    .footer-content {
        flex-direction: column;
        gap: 20px;

        text-align: center;
    }
}

/* ===================================
   COMPARADOR PROFESIONAL
=================================== */

.card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
}

.card-ready {
    color: #34d399;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 1px;
}

.card-pending {
    color: #64748b;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 1px;
}

.comparison-heading {
    text-align: center;
    margin-bottom: 35px;
}

.comparison-heading h2 {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(35px, 5vw, 55px);
    letter-spacing: -2px;
    margin: 8px 0 5px;
}

.comparison-heading p {
    color: var(--text-secondary);
    font-size: 15px;
}

.versus-header {
    display: grid;
    grid-template-columns: 1fr 80px 1fr;
    align-items: center;
    text-align: center;
    margin-bottom: 20px;
}

.versus-header span {
    color: var(--text-secondary);
    font-size: 9px;
    letter-spacing: 2px;
    font-weight: 800;
}

.versus-header strong {
    width: 54px;
    height: 54px;
    margin: auto;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--gradient);
    color: #021017;
    font-family: "Space Grotesk", sans-serif;
    font-size: 15px;
    box-shadow:
        0 0 35px
        rgba(56, 189, 248, .22);
}

.comparison-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
}

.product-compare-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 18px;
    background:
        linear-gradient(
            145deg,
            #111827,
            #090d16
        );
}

.product-number {
    position: absolute;
    right: 20px;
    top: 5px;
    font-family: "Space Grotesk", sans-serif;
    font-size: 58px;
    font-weight: 800;
    color: rgba(255,255,255,.025);
}

.product-brand-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 24px 0;
    position: relative;
    z-index: 2;
}

.product-badge {
    background: rgba(56,189,248,.09);
    border: 1px solid rgba(56,189,248,.18);
    color: var(--blue);
    padding: 5px 10px;
    border-radius: 30px;
    font-size: 8px;
    letter-spacing: 1px;
    font-weight: 800;
}

.product-brand {
    font-size: 10px;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 2px;
}

.product-visual {
    height: 210px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    margin: 10px 18px;
    border-radius: 13px;
    background:
        radial-gradient(
            circle at center,
            rgba(56,189,248,.12),
            rgba(255,255,255,.015)
        );
    border: 1px solid rgba(255,255,255,.04);
}

.product-visual-glow {
    width: 150px;
    height: 150px;
    position: absolute;
    background: rgba(56,189,248,.16);
    filter: blur(60px);
}

.product-logo-letter {
    position: relative;
    z-index: 2;
    width: 100px;
    height: 100px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(56,189,248,.35);
    border-radius: 22px;
    font-family: "Space Grotesk", sans-serif;
    font-size: 52px;
    font-weight: 700;
    color: var(--blue);
    background:
        linear-gradient(
            145deg,
            #172235,
            #090e18
        );
    transform: rotate(-4deg);
    box-shadow:
        0 20px 50px
        rgba(0,0,0,.35);
}

.product-visual-name {
    z-index: 2;
    margin-top: 14px;
    font-size: 9px;
    letter-spacing: 4px;
    color: var(--text-secondary);
    text-transform: uppercase;
}

.product-info {
    padding: 12px 26px 28px;
}

.product-manufacturer {
    color: var(--blue);
    font-size: 9px;
    letter-spacing: 2px;
    font-weight: 800;
    text-transform: uppercase;
}

.product-info h3 {
    font-family: "Space Grotesk", sans-serif;
    font-size: 25px;
    margin: 5px 0 10px;
    letter-spacing: -1px;
}

.product-highlight {
    min-height: 48px;
    color: var(--text-secondary);
    font-size: 12px;
    line-height: 1.7;
}

.product-price {
    margin: 22px 0;
    padding: 18px;
    border-radius: 12px;
    background: rgba(56,189,248,.055);
    border: 1px solid rgba(56,189,248,.12);
}

.product-price span,
.product-price small {
    display: block;
}

.product-price span {
    color: var(--text-secondary);
    font-size: 8px;
    letter-spacing: 2px;
}

.product-price strong {
    display: block;
    color: var(--blue);
    font-family: "Space Grotesk", sans-serif;
    font-size: 24px;
    margin: 4px 0;
}

.product-price small {
    color: #64748b;
    font-size: 9px;
}

.spec-list {
    border-top: 1px solid var(--border);
}

.spec-row {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 11px 2px;
    border-bottom: 1px solid var(--border);
}

.spec-row span {
    color: var(--text-secondary);
    font-size: 11px;
}

.spec-row strong {
    text-align: right;
    color: #e2e8f0;
    font-size: 11px;
}

.source-link {
    display: inline-flex;
    margin-top: 20px;
    color: var(--blue);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .5px;
}

.source-link:hover {
    text-decoration: underline;
}

.recommendation-box {
    margin-top: 28px;
    padding: 28px 32px;
    display: flex;
    align-items: flex-start;
    gap: 22px;
    border-radius: 16px;
    background:
        linear-gradient(
            135deg,
            rgba(56,189,248,.11),
            rgba(34,211,238,.035)
        );
    border: 1px solid rgba(56,189,248,.24);
}

.recommendation-icon {
    min-width: 55px;
    height: 55px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: var(--gradient);
    color: #041018;
    font-size: 23px;
    box-shadow:
        0 10px 30px
        rgba(56,189,248,.16);
}

.recommendation-label {
    color: var(--blue);
    font-size: 9px;
    letter-spacing: 2px;
    font-weight: 800;
}

.recommendation-box h3 {
    font-family: "Space Grotesk", sans-serif;
    font-size: 24px;
    margin: 3px 0 8px;
}

.recommendation-box p {
    color: #b0becd;
    line-height: 1.8;
    font-size: 12px;
}

.price-warning {
    margin-top: 16px;
    padding: 15px 18px;
    color: #64748b;
    border-left: 2px solid #334155;
    font-size: 10px;
    line-height: 1.7;
}

.price-warning strong {
    color: #94a3b8;
}

.coming-soon {
    min-height: 360px;
    padding: 60px 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    border: 1px dashed rgba(56,189,248,.25);
    border-radius: 18px;
    background:
        radial-gradient(
            circle at center,
            rgba(56,189,248,.07),
            transparent 50%
        );
}

.coming-icon {
    font-size: 55px;
    margin-bottom: 20px;
}

.coming-soon > span {
    color: var(--blue);
    font-size: 9px;
    letter-spacing: 3px;
    font-weight: 800;
}

.coming-soon h3 {
    font-family: "Space Grotesk", sans-serif;
    font-size: 27px;
    margin: 8px 0 12px;
}

.coming-soon p {
    max-width: 520px;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.8;
}

@media (max-width: 750px) {

    .comparison-grid {
        grid-template-columns: 1fr;
    }

    .versus-header {
        display: none;
    }

    .recommendation-box {
        flex-direction: column;
    }

    .product-visual {
        height: 180px;
    }

}


/* ==================================================
   CORRECCIÓN FINAL DE IMÁGENES DE PRODUCTOS
   Centrado + producto completo + proporción original
================================================== */

.product-visual {
    height: 250px !important;

    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;

    padding: 20px !important;

    overflow: hidden !important;

    position: relative !important;

    background:
        radial-gradient(
            circle at center,
            rgba(56, 189, 248, 0.09),
            rgba(255, 255, 255, 0.02) 55%,
            transparent 85%
        ) !important;
}


.product-real-image {
    position: relative !important;

    z-index: 2 !important;

    display: block !important;

    width: 100% !important;
    height: 190px !important;

    max-width: 100% !important;
    max-height: 190px !important;

    object-fit: contain !important;
    object-position: center center !important;

    margin: auto !important;

    padding: 8px !important;

    box-sizing: border-box !important;

    transform: none !important;

    filter:
        drop-shadow(
            0 15px 20px
            rgba(0, 0, 0, 0.30)
        ) !important;
}


.product-compare-card:hover
.product-real-image {
    transform: scale(1.025) !important;

    filter:
        drop-shadow(
            0 18px 25px
            rgba(0, 0, 0, 0.38)
        ) !important;
}


.product-visual-name {
    position: relative !important;

    z-index: 3 !important;

    margin-top: 8px !important;

    text-align: center !important;

    flex-shrink: 0 !important;
}


/* Imágenes verticales también quedan centradas */

.product-real-image[src*="ups"],
.product-real-image[src*="cp1500"],
.product-real-image[src*="br1500"] {
    max-height: 200px !important;
    width: auto !important;
}


/* Mejor visualización en pantallas pequeñas */

@media (max-width: 750px) {

    .product-visual {
        height: 225px !important;
        padding: 15px !important;
    }

    .product-real-image {
        height: 165px !important;
        max-height: 165px !important;
        width: 100% !important;
        object-fit: contain !important;
        object-position: center !important;
    }

}


/* ==========================================================
   HARDWARE LAB — PULIDO VISUAL FINAL 2026
========================================================== */

:root {
    --hl-bg: #050911;
    --hl-bg-soft: #09111e;
    --hl-panel: rgba(12, 21, 36, .92);
    --hl-panel-soft: rgba(15, 27, 45, .78);

    --hl-border: rgba(112, 176, 255, .14);
    --hl-border-strong: rgba(55, 200, 255, .30);

    --hl-cyan: #35c8f4;
    --hl-cyan-bright: #5cddff;

    --hl-text: #f5f8ff;
    --hl-muted: #9aa9c0;

    --hl-shadow:
        0 20px 55px rgba(0, 0, 0, .35);

    --hl-glow:
        0 0 40px rgba(53, 200, 244, .10);
}


/* ======================================
   BASE
====================================== */

html {
    scroll-behavior: smooth;
}

body {
    background:
        radial-gradient(
            circle at 20% 5%,
            rgba(0, 139, 210, .10),
            transparent 30%
        ),
        radial-gradient(
            circle at 85% 15%,
            rgba(0, 92, 180, .09),
            transparent 32%
        ),
        var(--hl-bg);

    color: var(--hl-text);
}


/* ======================================
   NAVBAR
====================================== */

header,
nav,
.navbar,
.main-nav {
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
}

header {
    border-bottom:
        1px solid rgba(255, 255, 255, .055);
}


/* ======================================
   HERO
====================================== */

.hero {
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: "";

    position: absolute;
    inset: 0;

    pointer-events: none;

    background:
        radial-gradient(
            circle at 70% 45%,
            rgba(32, 180, 255, .14),
            transparent 38%
        );
}

.hero h1 {
    letter-spacing: -.04em;
    line-height: .98;
}

.hero p {
    color: var(--hl-muted);
    line-height: 1.65;
}


/* ======================================
   BOTONES
====================================== */

button,
.btn,
.hero-button,
.cta-button {
    transition:
        transform .22s ease,
        box-shadow .22s ease,
        border-color .22s ease,
        background .22s ease;
}

button:hover,
.btn:hover,
.hero-button:hover,
.cta-button:hover {
    transform: translateY(-2px);
}

.primary-btn,
.btn-primary {
    box-shadow:
        0 12px 35px rgba(53, 200, 244, .22);
}


/* ======================================
   TARJETAS DE CATEGORÍAS
====================================== */

.category-card,
.hardware-card,
.component-card {
    position: relative;

    overflow: hidden;

    border:
        1px solid var(--hl-border) !important;

    background:
        linear-gradient(
            145deg,
            rgba(13, 25, 42, .94),
            rgba(8, 17, 30, .88)
        ) !important;

    box-shadow:
        0 12px 35px rgba(0, 0, 0, .18);

    transition:
        transform .25s ease,
        border-color .25s ease,
        box-shadow .25s ease;
}

.category-card::before,
.hardware-card::before,
.component-card::before {
    content: "";

    position: absolute;

    width: 180px;
    height: 180px;

    right: -80px;
    top: -90px;

    background:
        radial-gradient(
            circle,
            rgba(53, 200, 244, .12),
            transparent 68%
        );

    pointer-events: none;
}

.category-card:hover,
.hardware-card:hover,
.component-card:hover {
    transform: translateY(-5px);

    border-color:
        rgba(53, 200, 244, .40) !important;

    box-shadow:
        0 18px 46px rgba(0, 0, 0, .30),
        0 0 30px rgba(53, 200, 244, .06);
}


/* ======================================
   MODAL COMPARATIVO
====================================== */

.modal-content,
.comparison-modal,
.compare-modal,
.modal-container {
    background:
        linear-gradient(
            150deg,
            rgba(8, 14, 25, .985),
            rgba(11, 19, 33, .985)
        ) !important;

    border:
        1px solid rgba(111, 158, 216, .20) !important;

    box-shadow:
        0 35px 100px rgba(0, 0, 0, .60),
        0 0 60px rgba(37, 175, 255, .05);
}


/* ======================================
   TARJETAS DE COMPARACIÓN
====================================== */

.product-compare-card {
    position: relative;

    overflow: hidden;

    background:
        linear-gradient(
            150deg,
            rgba(15, 26, 45, .98),
            rgba(9, 17, 30, .96)
        ) !important;

    border:
        1px solid rgba(117, 167, 225, .16) !important;

    box-shadow:
        inset 0 1px rgba(255, 255, 255, .025),
        0 20px 45px rgba(0, 0, 0, .16);

    transition:
        border-color .25s ease,
        transform .25s ease,
        box-shadow .25s ease;
}

.product-compare-card:hover {
    border-color:
        rgba(53, 200, 244, .30) !important;

    box-shadow:
        inset 0 1px rgba(255, 255, 255, .03),
        0 24px 55px rgba(0, 0, 0, .25),
        0 0 32px rgba(53, 200, 244, .045);
}


/* ======================================
   FOTOGRAFÍAS
====================================== */

.product-visual {
    height: 270px !important;

    display: flex !important;
    flex-direction: column !important;

    align-items: center !important;
    justify-content: center !important;

    padding: 22px !important;

    border:
        1px solid rgba(104, 157, 218, .10) !important;

    border-radius: 18px !important;

    background:
        radial-gradient(
            circle at center,
            rgba(42, 167, 240, .10),
            rgba(9, 18, 32, .35) 58%,
            transparent 88%
        ) !important;
}

.product-real-image {
    width: 100% !important;
    height: 200px !important;

    max-width: 94% !important;
    max-height: 200px !important;

    object-fit: contain !important;
    object-position: center !important;

    padding: 4px !important;

    filter:
        drop-shadow(
            0 18px 25px rgba(0, 0, 0, .34)
        ) !important;

    transition:
        transform .30s ease,
        filter .30s ease;
}

.product-compare-card:hover
.product-real-image {
    transform: scale(1.035) !important;

    filter:
        drop-shadow(
            0 22px 30px rgba(0, 0, 0, .42)
        ) !important;
}


/* ======================================
   PRECIO
====================================== */

.product-price {
    position: relative;

    overflow: hidden;

    background:
        linear-gradient(
            145deg,
            rgba(11, 35, 53, .88),
            rgba(9, 26, 42, .88)
        ) !important;

    border:
        1px solid rgba(53, 200, 244, .23) !important;

    box-shadow:
        inset 0 1px rgba(255, 255, 255, .025);
}

.product-price::after {
    content: "";

    position: absolute;

    width: 120px;
    height: 120px;

    right: -55px;
    bottom: -70px;

    background:
        radial-gradient(
            circle,
            rgba(53, 200, 244, .10),
            transparent 70%
        );
}

.product-price strong {
    color: var(--hl-cyan) !important;

    text-shadow:
        0 0 22px rgba(53, 200, 244, .12);
}


/* ======================================
   TABLAS / ESPECIFICACIONES
====================================== */

.product-specs li,
.spec-row {
    border-color:
        rgba(255, 255, 255, .055) !important;
}


/* ======================================
   RECOMENDACIÓN
====================================== */

.recommendation,
.recommendation-box,
.product-recommendation {
    background:
        linear-gradient(
            145deg,
            rgba(8, 36, 48, .88),
            rgba(8, 25, 40, .90)
        ) !important;

    border:
        1px solid rgba(53, 200, 244, .20) !important;
}


/* ======================================
   BADGES
====================================== */

.product-badge,
.badge {
    border:
        1px solid rgba(53, 200, 244, .32) !important;

    background:
        rgba(27, 128, 178, .13) !important;

    color:
        var(--hl-cyan-bright) !important;

    box-shadow:
        inset 0 0 12px rgba(53, 200, 244, .04);
}


/* ======================================
   SCROLLBAR
====================================== */

::-webkit-scrollbar {
    width: 10px;
}

::-webkit-scrollbar-track {
    background: #070c14;
}

::-webkit-scrollbar-thumb {
    background:
        linear-gradient(
            #193348,
            #24546c
        );

    border-radius: 10px;

    border:
        2px solid #070c14;
}

::-webkit-scrollbar-thumb:hover {
    background:
        linear-gradient(
            #24546c,
            #2b7694
        );
}


/* ======================================
   SELECCIÓN DE TEXTO
====================================== */

::selection {
    background:
        rgba(53, 200, 244, .30);

    color: white;
}


/* ======================================
   RESPONSIVE
====================================== */

@media (max-width: 800px) {

    .product-visual {
        height: 220px !important;
    }

    .product-real-image {
        height: 155px !important;
        max-height: 155px !important;
    }

    .hero h1 {
        line-height: 1.03;
    }
}



/* ============================================
   FOOTER ACADÉMICO
============================================ */

.hl-project-footer {
    width: 100%;

    display: grid;

    grid-template-columns:
        1fr auto 1fr;

    align-items: center;

    gap: 30px;

    padding:
        22px
        clamp(24px, 6vw, 90px);

    margin-top: 70px;

    border-top:
        1px solid rgba(255, 255, 255, .06);

    background:
        rgba(4, 9, 16, .90);

    color:
        #8997aa;

    font-size: .82rem;
}

.hl-footer-brand {
    display: flex;
    align-items: center;

    gap: 16px;
}

.hl-footer-brand strong {
    color: #f5f8ff;

    letter-spacing: .14em;
}

.hl-footer-info {
    display: flex;
    align-items: center;

    gap: 10px;

    white-space: nowrap;
}

.hl-footer-date {
    text-align: right;
}


@media (max-width: 900px) {

    .hl-project-footer {
        grid-template-columns: 1fr;

        text-align: center;

        justify-items: center;
    }

    .hl-footer-brand {
        flex-direction: column;
        gap: 4px;
    }

    .hl-footer-info {
        flex-wrap: wrap;
        justify-content: center;
    }

    .hl-footer-date {
        text-align: center;
    }

}


/* ========================================
   ESTADÍSTICAS DEL ÁLBUM
======================================== */

.hl-stats {
    width:
        min(1180px, calc(100% - 40px));

    margin:
        38px auto 55px;

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    border:
        1px solid rgba(84, 156, 216, .13);

    border-radius:
        20px;

    overflow: hidden;

    background:
        linear-gradient(
            145deg,
            rgba(11, 23, 39, .82),
            rgba(6, 15, 27, .88)
        );

    box-shadow:
        0 22px 55px rgba(0, 0, 0, .18);
}

.hl-stat {
    position: relative;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    padding:
        26px 18px;

    text-align: center;
}

.hl-stat:not(:last-child) {
    border-right:
        1px solid rgba(255, 255, 255, .055);
}

.hl-stat strong {
    font-size:
        clamp(2rem, 4vw, 3rem);

    color:
        #39c8f4;

    line-height: 1;
}

.hl-stat span {
    margin-top: 8px;

    color:
        #96a5b9;

    font-size: .88rem;
}


@media (max-width: 700px) {

    .hl-stats {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .hl-stat {
        border-bottom:
            1px solid rgba(255, 255, 255, .055);
    }

}


/* =====================================
   PRECIO EN QUETZALES
===================================== */


            repeat(3, minmax(0, 1fr)) !important;

        gap:
            24px !important;
    }

}


@media (
    min-width: 760px
) and (
    max-width: 1179px
) {

    #components-grid,
    .components-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr)) !important;

        gap:
            22px !important;
    }

}


@media (max-width: 759px) {

    .component-card {
        padding:
            18px !important;
    }

    .card-comparison-visual {
        margin:
            15px 0 18px;
    }

}


/* =========================================================
   ELIMINAR VESTIGIOS DEL DISEÑO ANTERIOR
========================================================= */

.hl-ai-visual,
.hl-category-visual {
    display:
        none !important;
}



/* =========================================================
   HARDWARE LAB
   MEJORA VISUAL INTERNA DE COMPARACIONES
   Azul + Verde estilo neón
========================================================= */

/* Fondo general del modal / comparación */
.comparison-modal,
.modal-content,
.comparison-content,
.comparison-wrapper {
    background:
        radial-gradient(circle at top center, rgba(0, 180, 255, 0.08), transparent 32%),
        radial-gradient(circle at bottom right, rgba(0, 255, 140, 0.06), transparent 28%),
        linear-gradient(180deg, #07101b 0%, #040b14 100%) !important;
}


/* Título superior */
.comparison-modal h2,
.comparison-title,
.modal-content h2 {
    text-shadow:
        0 0 18px rgba(0, 180, 255, 0.14) !important;
}


/* Círculo VS */
.vs-badge,
.comparison-vs,
.vs-circle {
    background:
        linear-gradient(135deg, #33cfff, #1df2a4) !important;

    color: #02131b !important;

    font-weight: 900 !important;

    box-shadow:
        0 0 25px rgba(40, 214, 255, 0.28),
        0 0 35px rgba(44, 255, 170, 0.18) !important;
}


/* Tarjetas principales de los productos */
.product-card,
.comparison-card,
.product-panel,
.comparison-product,
.modal-product-card {
    position: relative !important;

    overflow: hidden !important;

    border-radius: 24px !important;

    background:
        linear-gradient(180deg, rgba(10, 22, 38, 0.95), rgba(6, 14, 24, 0.98)) !important;

    border:
        1px solid rgba(70, 180, 235, 0.18) !important;

    box-shadow:
        0 16px 38px rgba(0, 0, 0, 0.28),
        inset 0 1px 0 rgba(255, 255, 255, 0.03) !important;

    transition:
        transform .25s ease,
        box-shadow .25s ease,
        border-color .25s ease !important;
}


.product-card:hover,
.comparison-card:hover,
.product-panel:hover,
.comparison-product:hover,
.modal-product-card:hover {
    transform: translateY(-4px) !important;

    box-shadow:
        0 22px 52px rgba(0, 0, 0, 0.34),
        0 0 25px rgba(60, 210, 255, 0.08) !important;
}


/* Acento azul al primer producto */
.comparison-products > *:first-child,
.comparison-grid > *:first-child,
.products-comparison > *:first-child,
.modal-products > *:first-child {
    border-color: rgba(54, 194, 255, 0.30) !important;
    box-shadow:
        0 20px 45px rgba(0,0,0,.28),
        0 0 28px rgba(54, 194, 255, 0.10) !important;
}


/* Acento verde al segundo producto */
.comparison-products > *:last-child,
.comparison-grid > *:last-child,
.products-comparison > *:last-child,
.modal-products > *:last-child {
    border-color: rgba(42, 235, 149, 0.28) !important;
    box-shadow:
        0 20px 45px rgba(0,0,0,.28),
        0 0 28px rgba(42, 235, 149, 0.10) !important;
}


/* Imagen interna del producto */
.product-image-wrap,
.comparison-image,
.product-card .image-box,
.comparison-product .image-box {
    border-radius: 18px !important;

    background:
        radial-gradient(circle at center, rgba(40, 170, 255, 0.10), transparent 60%),
        linear-gradient(180deg, rgba(12, 27, 44, 0.95), rgba(8, 18, 31, 0.98)) !important;

    border:
        1px solid rgba(80, 195, 255, 0.14) !important;

    box-shadow:
        inset 0 0 35px rgba(0, 150, 255, 0.05),
        0 10px 24px rgba(0,0,0,.20) !important;
}


/* Caja de precio */
.price-box,
.price-card,
.reference-price,
.product-price-box {
    border-radius: 20px !important;

    background:
        linear-gradient(135deg, rgba(11, 38, 58, 0.96), rgba(7, 24, 39, 0.98)) !important;

    border:
        1px solid rgba(57, 211, 255, 0.22) !important;

    box-shadow:
        inset 0 0 25px rgba(40, 190, 255, 0.06),
        0 12px 28px rgba(0,0,0,.20) !important;
}


/* Si quieres que el segundo precio se vea más verde */
.comparison-products > *:last-child .price-box,
.comparison-grid > *:last-child .price-box,
.products-comparison > *:last-child .price-box,
.modal-products > *:last-child .price-box,
.comparison-products > *:last-child .price-card,
.comparison-grid > *:last-child .price-card,
.products-comparison > *:last-child .price-card,
.modal-products > *:last-child .price-card {
    border-color: rgba(42, 235, 149, 0.24) !important;

    box-shadow:
        inset 0 0 25px rgba(42, 235, 149, 0.05),
        0 12px 28px rgba(0,0,0,.20) !important;
}


/* Precio grande */
.price-box strong,
.price-card strong,
.reference-price strong,
.product-price-box strong,
.price-value {
    color: #40d6ff !important;
    text-shadow: 0 0 18px rgba(64, 214, 255, 0.16) !important;
}

.comparison-products > *:last-child .price-box strong,
.comparison-grid > *:last-child .price-box strong,
.products-comparison > *:last-child .price-box strong,
.modal-products > *:last-child .price-box strong,
.comparison-products > *:last-child .price-value,
.comparison-grid > *:last-child .price-value,
.products-comparison > *:last-child .price-value,
.modal-products > *:last-child .price-value {
    color: #3df0a5 !important;
    text-shadow: 0 0 18px rgba(61, 240, 165, 0.14) !important;
}


/* Filas de especificaciones */
.spec-row {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;

    gap: 14px !important;

    padding: 14px 16px !important;

    margin-bottom: 10px !important;

    border-radius: 14px !important;

    background:
        linear-gradient(90deg, rgba(255,255,255,0.015), rgba(255,255,255,0.025)) !important;

    border:
        1px solid rgba(67, 177, 233, 0.10) !important;

    transition:
        transform .18s ease,
        border-color .18s ease,
        background .18s ease !important;
}

.spec-row:hover {
    transform: translateX(3px) !important;

    border-color: rgba(61, 213, 255, 0.24) !important;

    background:
        linear-gradient(90deg, rgba(32, 143, 214, 0.07), rgba(27, 204, 134, 0.05)) !important;
}


/* Texto izquierda/derecha de las specs */
.spec-row span {
    color: #9fb3c7 !important;
}

.spec-row strong {
    color: #eef6ff !important;
}


/* Bordes verdes más notorios en specs del segundo producto */
.comparison-products > *:last-child .spec-row,
.comparison-grid > *:last-child .spec-row,
.products-comparison > *:last-child .spec-row,
.modal-products > *:last-child .spec-row {
    border-color: rgba(42, 235, 149, 0.12) !important;
}

.comparison-products > *:last-child .spec-row:hover,
.comparison-grid > *:last-child .spec-row:hover,
.products-comparison > *:last-child .spec-row:hover,
.modal-products > *:last-child .spec-row:hover {
    border-color: rgba(42, 235, 149, 0.28) !important;

    background:
        linear-gradient(90deg, rgba(16, 112, 85, 0.10), rgba(31, 201, 122, 0.06)) !important;
}


/* Etiquetas pequeñas arriba, como marca/categoría */
.product-tag,
.product-chip,
.product-badge,
.mini-badge {
    border-radius: 999px !important;

    border:
        1px solid rgba(69, 198, 255, 0.24) !important;

    background:
        rgba(21, 66, 102, 0.28) !important;

    color:
        #56d2ff !important;

    box-shadow:
        inset 0 0 10px rgba(0, 180, 255, 0.06) !important;
}


/* Links tipo “Ver fuente oficial” */
.source-link,
.product-link,
a.source-link,
a.product-link {
    color: #4bd7ff !important;
    font-weight: 700 !important;
}

.source-link:hover,
.product-link:hover,
a.source-link:hover,
a.product-link:hover {
    color: #66f3b2 !important;
}


/* Botón cerrar */
.close-modal,
.modal-close {
    border:
        1px solid rgba(85, 193, 245, 0.18) !important;

    background:
        rgba(8, 21, 35, 0.90) !important;

    box-shadow:
        0 0 18px rgba(0, 190, 255, 0.08) !important;
}


/* Responsive: más aire en móviles */
@media (max-width: 900px) {
    .product-card,
    .comparison-card,
    .product-panel,
    .comparison-product,
    .modal-product-card {
        border-radius: 20px !important;
    }

    .spec-row {
        padding: 12px 14px !important;
    }
}

